{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "whosthatcorvid",
    "compatibility_date": "2026-10-20",
    "workers_dev": false,
    "routes": [
        {
            "pattern": "whosthatcorvid.co.uk",
            "custom_domain": true
        },
        {
            "pattern": "www.whosthatcorvid.co.uk",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },
    "observability": {
        "enabled": true
    }
}